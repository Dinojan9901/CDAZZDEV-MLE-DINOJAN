# Copy to .env and fill in. .env is gitignored and must never be committed.

# Primary inference provider: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback provider, used when Groq rate-limits: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Default ticker for Task 1 and Task 3
DEFAULT_TICKER=NVDA

# Optional, Task 2 model upload and Task 3 tracing
HF_TOKEN=
WANDB_API_KEY=
LANGCHAIN_API_KEY=
